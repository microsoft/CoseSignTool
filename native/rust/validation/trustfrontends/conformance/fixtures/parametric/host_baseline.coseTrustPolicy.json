{
  "frontend": "cose-tp-json/v1",
  "primary_signing_key": {
    "all_of": [
      {
        "fact": "x509-cert-identity/v1",
        "predicate": { "thumbprint": { "$param": "expected_thumbprint" } }
      },
      {
        "fact": "x509-cert-identity-allowed/v1",
        "predicate": { "is_allowed": { "$param": "must_be_allowed", "default": true } }
      }
    ]
  }
}

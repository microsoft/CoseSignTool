{
  "frontend": "cose-tp-json/v1",
  "any_counter_signature": {
    "on_empty": "deny",
    "fact": "mst-receipt-issuer-host/v1",
    "predicate": {
      "operator": "Contains",
      "path": "$.hosts",
      "value": { "$param": "trusted_host", "default": "issuer.example.com" }
    }
  }
}
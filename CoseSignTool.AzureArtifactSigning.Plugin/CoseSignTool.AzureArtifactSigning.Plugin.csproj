<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CA1014</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>CoseSignTool.AzureArtifactSigning.Plugin</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <DelaySign>True</DelaySign>
    <AssemblyOriginatorKeyFile>..\StrongNameKeys\35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <!-- Plugin-specific properties to ensure all dependencies are copied for subdirectory isolation -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

    <!-- Disable NuGet package generation for plugins -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CoseSignTool.AzureArtifactSigning.Plugin.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoseSign1\CoseSign1.csproj">
      <Private>true</Private>
      <ExcludeAssets>none</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers</IncludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\CoseSign1.Transparent\CoseSign1.Transparent.csproj">
      <Private>true</Private>
      <ExcludeAssets>none</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers</IncludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\CoseSignTool.Abstractions\CoseSignTool.Abstractions.csproj">
      <Private>true</Private>
      <ExcludeAssets>none</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers</IncludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\CoseSign1.Certificates.AzureArtifactSigning\CoseSign1.Certificates.AzureArtifactSigning.csproj">
      <Private>true</Private>
      <ExcludeAssets>none</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers</IncludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Developer.ArtifactSigning.CryptoProvider">
      <Private>true</Private>
    </PackageReference>
    <PackageReference Include="Azure.ArtifactSigning.MST">
      <Private>true</Private>
    </PackageReference>
    <PackageReference Include="Azure.Identity" Aliases="global,IdentityAlias">
      <Private>true</Private>
    </PackageReference>
    <PackageReference Include="Azure.Core" VersionOverride="1.62.0">
      <Private>true</Private>
    </PackageReference>
    <!-- This type crosses plugin interfaces, so the plugin must use the host's assembly instance. -->
    <PackageReference Include="System.Security.Cryptography.Cose">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Post-build event to copy all runtime dependencies for plugin isolation -->
  <Target Name="CopyRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <!-- Get all runtime dependencies from deps.json -->
      <RuntimeDeps Include="$(OutDir)*.dll" Exclude="$(OutDir)$(AssemblyName).dll;$(OutDir)CoseSign*.dll;$(OutDir)CoseHandler.dll;$(OutDir)CoseIndirectSignature.dll" />
    </ItemGroup>
    <Message Text="Plugin runtime dependencies ready for deployment" Importance="high" />
  </Target>

</Project>
